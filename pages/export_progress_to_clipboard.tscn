offset_bottom = 1229.0
text = "This page exports your game save (progress) to your clipboard. There is also an option to send your save to yourself via email. See export life to clipboard for more information about how this works.

Please keep in mind that what you copy here DOESN'T include your life, only your overall progress, so your level, XP, achievements, etc. Also please keep in mind that copying importing your life in place of your progress, or your progress in place of your life, will cause the game to crash. It's important to differentiate between these two."
autowrap_mode = 3
metadata/_edit_use_anchors_ = true

